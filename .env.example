# Required: Steam Game Server Login Token
# Get yours at: https://steamcommunity.com/dev/managegameservers
SRCDS_TOKEN=

# Server Configuration
CS2_SERVERNAME=cs2 private server
CS2_CHEATS=0
CS2_IP=0.0.0.0
CS2_SERVER_HIBERNATE=0
CS2_PORT=27015
CS2_RCON_PORT=
CS2_MAXPLAYERS=10
CS2_RCONPW=changeme
CS2_MAPGROUP=mg_active
CS2_STARTMAP=de_inferno
CS2_GAMEALIAS=
CS2_GAMETYPE=0
CS2_GAMEMODE=1
CS2_LAN=0
CS2_SERVER_DELTATICKS_ENFORCE=2

# CSTV/SourceTV
TV_AUTORECORD=0
TV_ENABLE=0
TV_PORT=27020
TV_PW=changeme
TV_RELAY_PW=changeme
TV_MAXRATE=0
TV_DELAY=0
TV_RELAYVOICE=1

# Logs
CS2_LOG=on
CS2_LOG_FILE=0
CS2_LOG_ECHO=0
CS2_LOG_MONEY=0
CS2_LOG_DETAIL=0
CS2_LOG_ITEMS=0
CS2_DISCONNECT_KILLS=0
CS2_LOG_HTTP_URL=

# Steam Workshop (experimental)
CS2_HOST_WORKSHOP_MAP=
CS2_HOST_WORKSHOP_COLLECTION=

# Custom Config
CS2_CFG_URL=
CS2_ADDITIONAL_ARGS=
